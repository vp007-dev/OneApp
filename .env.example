# ==============================================================================
# TRACTORCARE ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Safe & Free Database Workaround)
# ------------------------------------------------------------------------------
# Safe & Free Default: Leave DATABASE_URL blank or unset.
# The app will automatically initialize a local SQLite database with Write-Ahead
# Logging (WAL) enabled (`tractorcare.db`), giving you 100% free, zero-cost,
# high-concurrency local storage.
#
# Alternatively, to connect a free cloud PostgreSQL (Supabase / Neon / Render):
# DATABASE_URL=postgresql://user:password@host.cloud.com:5432/tractorcare
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Required for production: set strong administrator credentials.
APP_USERNAME=admin
APP_PASSWORD=tractorcare2026

# Session cryptographic secret (at least 32 characters).
# If left blank, a secure 256-bit random key is auto-generated and stored in .session_secret
SESSION_SECRET_KEY=

# Inactive session timeout in seconds (default: 3600 = 1 hour)
SESSION_TIMEOUT_SECONDS=3600

# Set to "production" to enforce strict HTTPS session cookies
ENVIRONMENT=production

# ------------------------------------------------------------------------------
# 3. AI EXTRACTION ENGINE (OpenRouter)
# ------------------------------------------------------------------------------
# Optional: Used for AI parsing of unstructured vehicle policy documents.
# If omitted, TractorCare automatically uses smart regex and heuristics without crashing!
OPENROUTER_API_KEY=

# ------------------------------------------------------------------------------
# 4. AUTOMATED EMAIL RENEWAL NOTIFICATIONS
# ------------------------------------------------------------------------------
# Default recipient for administrator alert digests
ALERT_EMAIL=admin@example.com

# Option A: Standard SMTP (e.g. Gmail App Password, Outlook, Custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASS=

# Option B: Mailgun API (Optional alternative to SMTP)
MAILGUN_KEY=
MAILGUN_DOMAIN=

# ------------------------------------------------------------------------------
# 5. MOBILE & PWA PUSH NOTIFICATIONS (Firebase Admin SDK)
# ------------------------------------------------------------------------------
# Optional: Push notifications for registered mobile & Android devices.
# If left blank, the app runs in standby mode without crashing or throwing errors.
FIREBASE_PROJECT_ID=tractorcare-8586f
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
